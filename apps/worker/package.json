{
  "name": "@yourtj/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @yourtj/web build",
    "dev": "wrangler dev --config wrangler.jsonc",
    "build": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@yourtj/contracts": "workspace:*",
    "hono": "^4.12.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260716.1",
    "@yourtj/web": "workspace:*"
  }
}
