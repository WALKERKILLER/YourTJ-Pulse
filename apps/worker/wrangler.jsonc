{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yourtj-pulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-28",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/tiles/*"]
  },
  "routes": [
    {
      "pattern": "lyra4.icu/*",
      "zone_name": "lyra4.icu"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TILES",
      "bucket_name": "ytj-map"
    }
  ],
  "observability": {
    "enabled": true
  }
}
