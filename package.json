{
  "name": "yourtj-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "YourTJ Pulse campus map and digital twin platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter @yourtj/web build && pnpm --filter @yourtj/worker build && pnpm --filter './packages/*' build",
    "contracts:check": "pnpm --filter @yourtj/contracts protocol:check",
    "contracts:generate": "pnpm --filter @yourtj/contracts protocol:generate",
    "flutter:check": "node apps/flutter/tool/verify-architecture.mjs",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint && eslint e2e playwright.config.ts",
    "performance:check": "pnpm --filter @yourtj/web perf:check",
    "typecheck": "pnpm -r typecheck && pnpm e2e:typecheck",
    "data:build": "pnpm --filter @yourtj/data-pipeline build",
    "data:validate": "pnpm --filter @yourtj/data-pipeline validate",
    "deploy": "pnpm --filter @yourtj/worker deploy",
    "e2e": "playwright test",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json --noEmit",
    "legacy:dev": "wrangler dev --config wrangler.toml"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  }
}
